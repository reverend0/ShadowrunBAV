{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShadowrunBAV",
  "version": "0.2.0",
  "identifier": "com.shadowrunbav.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShadowrunBAV",
        "width": 1200,
        "height": 850,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENFOTk5RDE3NzQ5REZFRkQKUldUOS9wMTBGNTJaemc5Zmt0bXY4VXFTbUdJS3lzRkVpUDRPMmJXcW1HTnhsYThYTzlFMlZ0bmQK",
      "endpoints": ["https://github.com/reverend0/ShadowrunBAV/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
